{
  "manifest_version": 3,
  "name": "SwiftBlock",
  "version": "1.0.1",
  "description": "Hide Taylor Swift mentions from web pages — KardBlock-style keyword filtering for Manifest V3.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SwiftBlock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/defaults.js", "content/filter.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
